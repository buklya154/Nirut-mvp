# Copy this file to .env and fill in what you have. .env is gitignored -
# never commit real keys. Every engine below is optional; the audit runs
# with whichever ones have a key set (minimum: one).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Postgres connection string (Render Postgres add-on, or Supabase).
# Leave unset to fall back to local SQLite (nirut.db) - fine for local
# dev, but wiped on every redeploy on Render's free tier.
DATABASE_URL=

# Comma-separated origins allowed to call /api/* from the browser (your
# Lovable frontend's URL). Leave unset ("*") for local testing.
NIRUT_ALLOWED_ORIGIN=

# Per-visitor rate limit on POST /api/audit.
NIRUT_RATE_LIMIT=5 per hour

# Server-wide hard cap on total audits per day, across all visitors.
NIRUT_MAX_AUDITS_PER_DAY=50
